# Database: SQLite for local development; replace with postgresql+psycopg://... when needed.
DATABASE_URL=sqlite:///data/trading_bot.db

# Choose one config profile.
# app/config/trading_config.yaml      = default/generic
# app/config/trading_config_btc.yaml  = BTCUSD live profile
# app/config/trading_config_gold.yaml = GOLD/XAUUSD live profile
TRADING_CONFIG_PATH=app/config/trading_config.yaml

# MetaTrader 5 / XM. Leave credentials out to use the account already logged in to the terminal.
# Never commit real MT5_LOGIN or MT5_PASSWORD.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Common local XM example values:
# MT5_SERVER=XMGlobal-MT5 9
# MT5_TERMINAL_PATH=C:\Program Files\XM Global MT5\terminal64.exe

# LIVE has two gates: config bot.mode=LIVE AND this exact environment switch.
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
REQUIRE_DEMO_ACCOUNT=true
BROKER_STARTUP_ENABLED=true
AUTO_START_BOT=false

API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Optional: seed a fresh database with sanitized learning history.
LEARNING_SEED_PATH=data/learning_seed.jsonl
